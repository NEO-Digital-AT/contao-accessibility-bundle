{
    "name": "neo-digital/contao-accessibility-bundle",
    "type": "contao-bundle",
    "description": "Accessibility panel for Contao 5: a button opens a panel in which visitors adjust the display of the website, with quick options (low vision, dyslexia, concentration, epilepsy, motor skills, read aloud) and settings for text, colours and orientation, such as text size, readable and dyslexia font, contrast, reading guide and mask, page structure and read aloud. The choices stay in the visitor's browser.",
    "keywords": [
        "contao",
        "contao-bundle",
        "accessibility",
        "a11y",
        "frontend-module"
    ],
    "homepage": "https://github.com/NEO-Digital-AT/contao-accessibility-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "NEO Digital"
        }
    ],
    "support": {
        "issues": "https://github.com/NEO-Digital-AT/contao-accessibility-bundle/issues",
        "source": "https://github.com/NEO-Digital-AT/contao-accessibility-bundle"
    },
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3 || ^6.0",
        "doctrine/dbal": "^3.6 || ^4.0",
        "neo-digital/contao-basic-bundle": "^1.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/routing": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation-contracts": "^3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Neo\\AccessibilityBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Neo\\AccessibilityBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "contao-manager-plugin": "Neo\\AccessibilityBundle\\ContaoManager\\Plugin"
    }
}
